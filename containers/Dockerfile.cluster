FROM python:3.11.9-slim

ENV NUMBA_CACHE_DIR=/tmp
ENV MPLCONFIGDIR=/tmp

RUN apt-get update && apt-get install -y --no-install-recommends procps && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir \
        scanpy==1.10.3 \
        anndata==0.10.9 \
        leidenalg==0.10.2 \
        igraph==0.11.6 \
        matplotlib==3.8.4 \
        "pandas==2.2.0" \
        scipy==1.13.0 \
        numpy==1.24.3

LABEL reproducible="2026-07-01" \
      python="3.11.9" \
      scanpy="1.10.3" \
      anndata="0.10.9" \
      leidenalg="0.10.2" \
      igraph="0.11.6" \
      matplotlib="3.8.4" \
      pandas="2.2.0" \
      scipy="1.13.0" \
      numpy="1.24.3"
