FROM python:3.11.9-slim

ENV NUMBA_CACHE_DIR=/tmp
ENV MPLCONFIGDIR=/tmp

# parasail (scirpy IR distance) may need a compiler if no wheel matches the platform.
RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ \
        procps \
        libparasail-dev \
    && pip install --no-cache-dir \
        scanpy==1.10.3 \
        anndata==0.10.9 \
        mudata==0.3.1 \
        scirpy==0.17.2 \
        awkward==2.6.5 \
        airr==1.5.1 \
        matplotlib==3.8.4 \
        seaborn==0.13.2 \
        "pandas==2.2.0" \
        scipy==1.13.0 \
        numpy==1.24.3 \
        networkx==3.2.1 \
        igraph==0.11.6 \
        squarify==0.4.3 \
        adjusttext==1.2.0 \
        pooch==1.8.2 \
        "parasail==1.3.4" \
        python-levenshtein==0.25.1 \
        scikit-learn==1.4.2 \
        tqdm==4.66.4 \
        joblib==1.4.2 \
        "setuptools==70.3.0" \
        numba==0.59.1 \
        llvmlite==0.42.0 \
    && apt-get purge -y g++ \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

LABEL reproducible="2026-11-16" \
      python="3.11.9" \
      scanpy="1.10.3" \
      anndata="0.10.9" \
      mudata="0.3.1" \
      scirpy="0.17.2" \
      awkward="2.6.5" \
      airr="1.5.1" \
      matplotlib="3.8.4" \
      seaborn="0.13.2" \
      pandas="2.2.0" \
      scipy="1.13.0" \
      numpy="1.24.3" \
      numba="0.59.1" \
      llvmlite="0.42.0"
