# Seurat 5.1.0 + stable dependencies – reproducible build for MapQuery annotation
FROM satijalab/seurat:5.0.0

# System deps + curl binary with pinned versions
RUN apt-get update && apt-get install -y \
    procps=3.3.17-5 \
    curl=7.74.0-1.3+deb11u11 \
    libcurl4-openssl-dev=7.74.0-1.3+deb11u11 \
    libssl-dev=1.1.1n-0+deb11u6 \
    libxml2-dev=2.9.10+dfsg-6.7+deb11u7 \
    libhdf5-dev=1.10.6+repack-5+deb11u1 \
    libpng-dev=1.6.37-3 \
    libboost-all-dev=1.74.0-9 \
    && rm -rf /var/lib/apt/lists/*

# Seurat 5.1.0 from CRAN (stable, compatible with SeuratObject)
RUN R --slave -e "remotes::install_version('Seurat', version = '5.1.0', repos = 'https://cloud.r-project.org', Ncpus = 2)"

# Core script packages with pinned versions
RUN R --slave -e "options(Ncpus = 2); \
  remotes::install_version('remotes', '2.4.2.1', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('patchwork', '1.2.0', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('dplyr', '1.1.4', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('ggplot2', '3.5.0', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('plyr', '1.8.9', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('optparse', '1.7.3', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('hdf5r', '1.3.8', repos = 'https://cloud.r-project.org')"

# Bioconductor packages with pinned versions
RUN R --slave -e "BiocManager::install(c('presto', 'SeuratDisk', 'glmGamPoi'), version = '3.18', ask = FALSE, force = TRUE)"

# Matrix package compatibility (essential for Seurat 5.1.0)
RUN R --slave -e "remotes::install_version('Matrix', version = '1.6-5', repos = 'https://cloud.r-project.org')"

# Directories + reference download (pbmc_multimodal fixed to known URL/hash)
RUN mkdir -p /data /references

RUN cd /references && \
    curl -L -o pbmc_multimodal.h5seurat \
         -H "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0 Safari/537.36" \
         https://atlas.fredhutch.org/data/nygc/multimodal/pbmc_multimodal.h5seurat

WORKDIR /data

CMD ["R"]

LABEL reproducible="2026-07-01" \
      r-base="4.4.0" \
      seurat="5.1.0" \
      remotes="2.4.2.1" \
      patchwork="1.2.0" \
      dplyr="1.1.4" \
      ggplot2="3.5.0" \
      plyr="1.8.9" \
      optparse="1.7.3" \
      hdf5r="1.3.8" \
      matrix="1.6-5" \
      presto="bioc3.18" \
      seuratdisk="bioc3.18" \
      glmgampoi="bioc3.18" \
      procps="3.3.17-5" \
      curl="7.74.0-1.3+deb11u11"
