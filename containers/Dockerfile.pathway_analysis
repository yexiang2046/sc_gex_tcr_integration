FROM rocker/r-ver:4.4.0

ENV NUMBA_CACHE_DIR=/tmp
ENV MPLCONFIGDIR=/tmp

RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    libhdf5-dev=1.10.6+repack-5+deb11u1 \
    libssl-dev=1.1.1n-0+deb11u6 \
    libcurl4-openssl-dev=7.74.0-1.3+deb11u11 \
    libxml2-dev=2.9.10+dfsg-6.7+deb11u7 \
    && rm -rf /var/lib/apt/lists/*

# Install base packages with pinned versions
RUN R --slave -e "options(Ncpus = 2); \
  remotes::install_version('optparse', '1.7.3', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('data.table', '1.14.10', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('dplyr', '1.1.4', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('tidyr', '1.3.0', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('ggplot2', '3.5.0', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('patchwork', '1.2.0', repos = 'https://cloud.r-project.org'); \
  remotes::install_version('pheatmap', '1.0.12', repos = 'https://cloud.r-project.org')"

# Install BiocManager
RUN R --slave -e "install.packages('BiocManager', repos = 'https://cloud.r-project.org', quiet = TRUE)"

# Install Bioconductor packages with pinned versions
RUN R --slave -e "BiocManager::install('fgsea', version='3.18', ask = FALSE, force = TRUE); \
  BiocManager::install('msigdbr', version='3.18', ask = FALSE, force = TRUE); \
  BiocManager::install('rhdf5', version='3.18', ask = FALSE, force = TRUE)"

WORKDIR /data
CMD ["R"]

LABEL reproducible="2026-07-01" \
      r-base="4.4.0" \
      optparse="1.7.3" \
      data.table="1.14.10" \
      dplyr="1.1.4" \
      tidyr="1.3.0" \
      ggplot2="3.5.0" \
      patchwork="1.2.0" \
      pheatmap="1.0.12" \
      fgsea="3.18" \
      msigdbr="3.18" \
      rhdf5="3.18" \
      libhdf5-dev="1.10.6+repack-5+deb11u1" \
      libssl-dev="1.1.1n-0+deb11u6" \
      libcurl4-openssl-dev="7.74.0-1.3+deb11u11" \
      libxml2-dev="2.9.10+dfsg-6.7+deb11u7"
