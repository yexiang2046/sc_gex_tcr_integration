params {
    input        = "samplesheet.csv"
    outdir       = "results"
    min_genes    = 200
    max_genes    = 6000
    mt_threshold = 15
    min_cells    = 3
    seed             = 42
    n_hvgs           = 2000
    leiden_resolution = 0.5
    n_top_markers      = 20
    celltypist_model   = "Immune_All_Low.pkl"
    seurat_max_cells   = 0
    seurat_all_genes   = true
    scenic_db_dir      = "data/scenic_db"
    scenic_tfs         = "data/scenic_db/allTFs_hg38.txt"
    scenic_motifs      = "data/scenic_db/motifs-v9-nr.hgnc-m0.001-o0.0.tbl"
    scenic_n_cells          = 5000
    scenic_num_workers      = 4      // GRNBoost2 + AUCell workers (CPU-bound, use all cores)
    scenic_ctx_num_workers  = 1      // cisTarget: 1 = sequential path (no Dask fork)
    scenic_n_hvgs           = 6000   // wider gene space to recover more JUNB/AP1 targets
    scenic_top_targets      = 300    // more edges per TF better motif coverage
    scenic_module_chunksize = 100    // chunk size for in-process cisTarget loop
    // Root of Cell Ranger V(D)J outs (bind-mounted into TCR_INTEGRATE). Samplesheet
    // column tcr_outs points at per-library subdirectories under this root.
    // Note the space in the folder name: data/TCR 12113/{01..16}_TCR
    tcr_dir                 = "data/TCR 12113"
    pathway_group_by         = "predicted.celltype.l2"  // obs column for grouping pathways by cell type (set to empty for all cells)
    pathway_categories       = "H,C2,C5"  // MSigDB categories: H=Hallmark, C2=Curated, C5=GO, C3=TF, etc.
    pathway_species          = "Homo sapiens"
    pathway_pval_thresh      = 0.05       // adjusted p-value threshold for DE gene filtering
    pathway_top_pathways     = 15         // number of top pathways to visualize in plots
}

process {
    maxForks = 1
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}

timeline.enabled   = true
timeline.overwrite = true
report.enabled     = true
report.overwrite   = true
trace.enabled      = true
trace.overwrite    = true
